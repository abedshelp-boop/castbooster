# castbooster.ai — example environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.

# ==============================================================================
# Pillar 3.6 — Cloud RIFE VFI MVP (single-user)
# ==============================================================================

# Random hex secret (≥256 bits). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Must match the CLOUD_API_KEY env var on the RunPod pod.
CLOUD_API_KEY=

# Personal API key from https://runpod.io/console/user/settings → API Keys.
# Used by the orchestrator to spin pods + terminate orphans.
RUNPOD_API_KEY=

# Docker image to deploy. Pin to a specific version tag — never `:latest` in
# production. v0.3.1 adds in-pod source-proxy (egydead header passthrough).
CLOUD_WORKER_IMAGE=ghcr.io/abedshelp-boop/castbooster-cloud-worker:v0.3.1

# GPU priority list (comma-separated, first-available wins). RunPod stock
# fluctuates hourly; multiple options reduce probability of stock-out.
# Documented good options:
#   - "NVIDIA GeForce RTX 4090" (~$0.69-0.79/hr SECURE)
#   - "NVIDIA RTX 6000 Ada Generation" (~$0.74-0.77/hr SECURE, Task 12 verified)
#   - "NVIDIA RTX A6000" (~$0.79/hr SECURE)
CLOUD_GPU_TYPES=NVIDIA GeForce RTX 4090,NVIDIA RTX 6000 Ada Generation,NVIDIA RTX A6000

# Optional override for the orchestrator's playlist-ready timeout.
# v0.3.0 spec says 90s. Bump only if Task 23 verifies engine cold-start
# regularly exceeds this. Leave empty to use the default.
# CLOUD_PLAYLIST_READY_TIMEOUT_S=90

# ==============================================================================
# Existing dev escape hatches (already understood by other modules)
# ==============================================================================

# Force passthrough mode (skip transcoder entirely). Useful for debugging
# the proxy layer in isolation.
# CASTBOOSTER_PASSTHROUGH=1
